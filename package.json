{
  "name": "wavelinknode",
  "version": "1.1.0",
  "description": "Wave Link Hotkey Manager",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:installer": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable"
  },
  "keywords": [],
  "author": "FairTech",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@darrellvs/node-wave-link-sdk": "file:./vendor/node-wave-link-sdk",
    "node-global-key-listener": "^0.3.0",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "app.fairtech.wavelinkhotkey",
    "productName": "Wave Link Hotkey Manager",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/WLHK.ico"
    },
    "nsis": {
      "artifactName": "WLHK.Setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "WLHK.exe"
    }
  }
}
